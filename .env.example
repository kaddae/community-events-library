# Supabase: the app switches from local preview data to the shared database
# once both of these are set. Both are public: the anon key is meant to be in
# the browser, and Row Level Security is what protects the data.
# Supabase is already connected in the Services tab, so these are set for you.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Never put the service_role key here or anywhere in this app.